# Google OAuth (do not commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account used only by Vercel server functions
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Existing inventory source-of-truth spreadsheet
GOOGLE_INVENTORY_SHEET_ID=

# Root Drive folder for photos, reports, invoices, quotations and backups
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional: restrict initial admin access to one Google account
ADMIN_GOOGLE_EMAIL=
