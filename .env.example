# Google backend authorization used by Vercel Functions.
# These credentials authorize the server to read/write the inventory Sheet
# and create/manage files in the configured Drive folder.
GOOGLE_BACKEND_CLIENT_ID=
GOOGLE_BACKEND_CLIENT_SECRET=
GOOGLE_BACKEND_REFRESH_TOKEN=

# Live inventory source of truth
GOOGLE_INVENTORY_SHEET_ID=1yqqrQmx723dQYf7hjpH_nn7LUNv5wO5X3ZqIjhsROPg

# Drive root for product photos, reports, quotations, invoices and backups
GOOGLE_DRIVE_ROOT_FOLDER_ID=150zCdhwelWKqbcssc-OYrw33GjMWz5uU

# Google Sign-In for app users will be added separately.
GOOGLE_LOGIN_CLIENT_ID=

# Optional first-admin restriction
ADMIN_GOOGLE_EMAIL=
