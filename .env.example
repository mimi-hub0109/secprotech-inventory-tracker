# Google Sign-In (we will add this after the data bridge works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel -> Google Apps Script data bridge
# Keep the real values only in Vercel Environment Variables.
APPS_SCRIPT_WEB_APP_URL=
